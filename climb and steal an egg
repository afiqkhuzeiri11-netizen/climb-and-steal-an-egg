local function isCarryKeyword(str)
	local s = string.lower(tostring(str or ""))
	return s:find("egg", 1, true)
		or s:find("pet", 1, true)
		or s:find("steal", 1, true)
		or s:find("carry", 1, true)
		or s:find("stolen", 1, true)
		or s:find("crate", 1, true)
end

local function recordStarterTools()
	table.clear(State.StarterToolNames)
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if isValidInstance(backpack) then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and not isCarryKeyword(item.Name) then
				State.StarterToolNames[item.Name] = true
			end
		end
	end
end

local function countCarriedObjects()
	local char = LocalPlayer.Character
	if not isValidInstance(char) then return 0 end

	local count = 0
	local seen = {}

	for _, child in ipairs(char:GetChildren()) do
		if isValidInstance(child) and not child:IsA("Accessory") and not child:IsA("Shirt") and not child:IsA("Pants") and not child:IsA("BodyColors") then
			if child:IsA("Tool") then
				if not State.StarterToolNames[child.Name] or isCarryKeyword(child.Name) then
					seen[child] = true
					count = count + 1
				end
			elseif child:IsA("Model") then
				if isCarryKeyword(child.Name) or child:GetAttribute("IsEgg") ~= nil or child:GetAttribute("Owner") ~= nil then
					seen[child] = true
					count = count + 1
				end
			elseif child:IsA("BasePart") and isCarryKeyword(child.Name) then
				seen[child] = true
				count = count + 1
			end
		end
	end

	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("Weld") or desc:IsA("WeldConstraint") or desc:IsA("Motor6D") then
			local p0, p1 = desc.Part0, desc.Part1
			local ext = nil
			if isValidInstance(p0) and p0 ~= SafePad and not p0:IsDescendantOf(char) then
				ext = p0
			elseif isValidInstance(p1) and p1 ~= SafePad and not p1:IsDescendantOf(char) then
				ext = p1
			end

			if ext then
				local rootModel = ext:FindFirstAncestorOfClass("Model") or ext
				if not seen[rootModel] and rootModel ~= Workspace then
					seen[rootModel] = true
					count = count + 1
				end
			end
		end
	end

	for _, holder in ipairs({ char, LocalPlayer }) do
		if isValidInstance(holder) then
			local ok, attrs = pcall(function() return holder:GetAttributes() end)
			if ok and type(attrs) == "table" then
				for k, v in pairs(attrs) do
					local kn = string.lower(tostring(k))
					if kn:find("carry", 1, true) or kn:find("egg", 1, true) or kn:find("holding", 1, true) or kn:find("stolen", 1, true) then
						if v ~= false and v ~= nil and v ~= "" and v ~= 0 then
							count = count + 1
						end
					end
				end
			end
		end
	end

	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if isValidInstance(backpack) then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and not State.StarterToolNames[item.Name] and isCarryKeyword(item.Name) then
				if not seen[item] then
					seen[item] = true
					count = count + 1
				end
			end
		end
	end

	return count
end

local function isEggGrabbedOrGone(eggObj, part, initialCarry)
	local char = LocalPlayer.Character
	if not isValidInstance(char) then return false end

	if countCarriedObjects() > initialCarry then
		return true
	end
	if isValidInstance(eggObj) then
		if eggObj:IsDescendantOf(char) then return true end
		local bp = LocalPlayer:FindFirstChild("Backpack")
		if isValidInstance(bp) and eggObj:IsDescendantOf(bp) then return true end
	end
	if not isValidInstance(eggObj) or not isValidInstance(part) or part.Transparency >= 0.88 then
		return true
	end

	local pr = eggObj:FindFirstChildWhichIsA("ProximityPrompt", true)
		or (isValidInstance(eggObj.Parent) and eggObj.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
	if isValidInstance(pr) and not pr.Enabled then
		return true
	end

	return false
end

