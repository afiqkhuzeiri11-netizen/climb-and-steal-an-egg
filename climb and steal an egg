local function moveCharacterTo(targetCF, forceInstantSnap)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        State.IsGliding = false
        return false
    end

    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(targetCF.Position, 2)
    end)

    if forceInstantSnap or Config.InstantSnapToEgg then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = targetCF
        return true
    end

    State.IsGliding = true
    State.CancelGlide = false

    local dist = (root.Position - targetCF.Position).Magnitude
    local duration = math.clamp(dist / math.max(30, Config.GlideSpeed), 0.05, 1.35)

    local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = targetCF
    })
    tw:Play()

    local waited = 0
    while waited < duration do
        if State.CancelGlide or not root.Parent or hum.Health <= 0 then
            tw:Cancel()
            break
        end
        waited = waited + task.wait(0.02)
    end

    if root and root.Parent and not State.CancelGlide and hum.Health > 0 then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = targetCF
    end

    State.IsGliding = false
    return true
end

-- INTI UTAMA V8: 6-Layer Hyper-Press yang Menembus Proteksi Pencet Game
local function executeHyperPressGrab(eggItem)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return false end

    local eggObj = eggItem.Object
    local part = eggItem.Part
    if not eggObj or not part or not part.Parent then return false end

    -- LAYER 6: Lepas tool yang sedang dipegang agar tangan kosong & siap membawa telur
    if Config.AutoUnequipTools then
        pcall(function() hum:UnequipTools() end)
    end

    local initialCarry = countCarriedObjects()

    -- Kumpulkan semua ProximityPrompt di telur, parent, maupun radius 12 studs dari telur
    local prompts = {}
    local seenPrompt = {}
    for _, d in ipairs(eggObj:GetDescendants()) do
        if d:IsA("ProximityPrompt") and not seenPrompt[d] then
            seenPrompt[d] = true
            table.insert(prompts, d)
        end
    end
    if eggObj.Parent then
        for _, d in ipairs(eggObj.Parent:GetDescendants()) do
            if d:IsA("ProximityPrompt") and not seenPrompt[d] then
                seenPrompt[d] = true
                table.insert(prompts, d)
            end
        end
    end
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and not seenPrompt[d] then
            local parentPart = d:FindFirstAncestorWhichIsA("BasePart") or (d:FindFirstAncestorOfClass("Model") and getPart(d:FindFirstAncestorOfClass("Model")))
            if parentPart and (parentPart.Position - part.Position).Magnitude <= 10 then
                seenPrompt[d] = true
                table.insert(prompts, d)
            end
        end
    end

    -- Baca durasi Hold asli server & buka kunci batas jarak/pandangan prompt
    local serverHold = 0
    for _, pr in ipairs(prompts) do
        if State.PromptOrigHold[pr] == nil then
            State.PromptOrigHold[pr] = pr.HoldDuration
        end
        if State.PromptOrigHold[pr] > serverHold then
            serverHold = State.PromptOrigHold[pr]
        end
        pr.RequiresLineOfSight = false
        pr.MaxActivationDistance = math.max(pr.MaxActivationDistance, 32)
    end

    -- LAYER 2: Berhenti Tepat di Samping Telur & Kunci Diam Sempurna (Jangan Di-Spam CFrame Lagi!)
    setNoclipMode(false)
    State.IsPressingEgg = true

    local standPos = part.Position + Vector3.new(0, 1.5, 2.2)
    local lookAtEggCF = CFrame.lookAt(standPos, part.Position)
    SafePad.CFrame = CFrame.new(standPos.X, standPos.Y - 3.3, standPos.Z)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = lookAtEggCF

    -- LAYER 1: Arahkan Kamera Menghadap Tepat ke Telur agar Roblox Memunculkan Tombol Prompt di Layar!
    if Config.AutoAimCameraToEgg then
        local camPos = standPos + Vector3.new(0, 3.5, 6)
        Camera.CFrame = CFrame.lookAt(camPos, part.Position)
    end

    -- Beri 2 frame agar mesin Roblox memicu event PromptShown secara resmi
    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()

    if State.ActivePromptShown and not seenPrompt[State.ActivePromptShown] then
        table.insert(prompts, State.ActivePromptShown)
    end

    -- Mulai Menahan Semua Prompt & Tombol E
    for _, pr in ipairs(prompts) do
        pcall(function() pr:InputHoldBegin() end)
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    end)

    -- Sentuh fisik telur sekali di awal
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, part, 0)
            firetouchinterest(root, part, 1)
        end)
    end

    local startHold = tick()
    local requiredWait = serverHold + Config.HoldBufferTime
    local maxTimeout = math.max(Config.MaxGrabWaitTime, requiredWait + 0.8)
    local grabConfirmed = false

    while (tick() - startHold) < maxTimeout do
        if not root.Parent or hum.Health <= 0 then break end
        if not part or not part.Parent then
            grabConfirmed = true
            break
        end

        local elapsed = tick() - startHold
        LiveStatus.Text = string.format(
            "Hyper-Press [%s]: Menahan %.1fs / %.1fs...",
            eggObj.Name, elapsed, requiredWait
        )

        -- Pertahankan arah kamera ke telur tanpa mengubah CFrame karakter (agar tidak dianggap bergerak oleh server!)
        root.AssemblyLinearVelocity = Vector3.zero
        if Config.AutoAimCameraToEgg then
            local camPos = root.Position + Vector3.new(0, 3.5, 6)
            Camera.CFrame = CFrame.lookAt(camPos, part.Position)
        end

        -- LAYER 3: Pencet tombol UI di layar HP (PlayerGui / ProximityPromptUI)
        if Config.AutoTapPlayerGuiButtons then
            local tapped = tapAllVisibleInteractButtons()
            if tapped > 0 then
                State.LastTriggerMethod = "UI Tap + Hold"
            end
        end

        -- LAYER 4: ClickDetector & fireproximityprompt setelah durasi server terpenuhi
        for _, cd in ipairs(eggObj:GetDescendants()) do
            if cd:IsA("ClickDetector") and fireclickdetector then
                pcall(function() fireclickdetector(cd) end)
            end
        end

        if elapsed >= serverHold and Config.UseSignalAndPromptAPI then
            for _, pr in ipairs(prompts) do
                if fireproximityprompt then
                    pcall(function() fireproximityprompt(pr) end)
                end
                if firesignal then
                    pcall(function() firesignal(pr.Triggered, LocalPlayer) end)
                end
            end
            State.LastTriggerMethod = "Prompt + Signal"
        end

        -- LAYER 5: Smart Remote Argument Fuzzer
        if elapsed >= (serverHold * 0.5) then
            fireSmartEggRemotes(eggObj, part, prompts[1])
        end

        -- Cek apakah telur sudah benar-benar menempel di karakter / masuk inventory!
        if isEggGrabbedOrGone(eggObj, part, initialCarry) then
            grabConfirmed = true
            State.LastTriggerMethod = "6-Layer Verified!"
            break
        end

        task.wait(0.08)
    end

    -- Selesai menahan -> lepaskan InputHoldEnd & Tombol E
    for _, pr in ipairs(prompts) do
        pcall(function() pr:InputHoldEnd() end)
        if fireproximityprompt then
            pcall(function() fireproximityprompt(pr) end)
        end
    end
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)

    State.IsPressingEgg = false
    State.VisitedEggs[eggObj] = tick() + Config.EggCooldownSec
    return grabConfirmed
end

-- Fungsi Setor Telur ke Deposit Pad Base dengan 6-Layer Press juga!
local function depositCarriedEggToBase()
    local targetDeposit = Config.DepositPadCFrame or Config.BaseCFrame
    if not targetDeposit then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    LiveStatus.Text = "Teleport ke Base & Menyetor Telur (Hyper-Deposit)..."
    moveCharacterTo(targetDeposit + Vector3.new(0, 1.8, 0), Config.InstantSnapToBase)
    setNoclipMode(false)

    local beforeCarry = countCarriedObjects()
    local startDep = tick()

    while (tick() - startDep) < Config.DepositStayTime do
        if not root.Parent or hum.Health <= 0 then break end

        root.AssemblyLinearVelocity = Vector3.zero
        if Config.AutoAimCameraToEgg then
            Camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 5, 6), targetDeposit.Position)
        end

        -- Pencet tombol UI Setor/Place jika muncul di layar HP
        if Config.AutoTapPlayerGuiButtons then
            tapAllVisibleInteractButtons()
        end

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Position - targetDeposit.Position).Magnitude < 18 then
                local n = string.lower(obj.Name)
                if n:find("deposit") or n:find("place") or n:find("deliver") or n:find("drop") or n:find("pad") or n:find("collect") or n:find("base") or n:find("stand") then
                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(root, obj, 0)
                            firetouchinterest(root, obj, 1)
                        end)
                    end
                end
                local pr = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if pr and pr.Enabled then
                    pr.RequiresLineOfSight = false
                    if fireproximityprompt then pcall(function() fireproximityprompt(pr) end) end
                    pcall(function()
                        pr:InputHoldBegin()
                        task.wait(0.04)
                        pr:InputHoldEnd()
                    end)
                end
            end
        end

        if countCarriedObjects() < beforeCarry then
            break
        end

        task.wait(0.08)
    end

    State.CollectedCount = State.CollectedCount + 1
end

