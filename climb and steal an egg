-- Poin #7: Kalkulasi Koordinat Klik UI Mobile Aman (absSize > 2 & pcall)
local function tapAllVisibleInteractButtons()
	if (tick() - State.LastUITapTick) < 0.16 then return 0 end
	State.LastUITapTick = tick()

	local pGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not isValidInstance(pGui) then return 0 end

	local tappedCount = 0
	local okInset, inset = pcall(function() return GuiService:GetGuiInset() end)
	if not okInset or not inset then
		inset = Vector2.new(0, 36)
	end

	for _, guiObj in ipairs(pGui:GetDescendants()) do
		if isValidInstance(guiObj) and (guiObj:IsA("TextButton") or guiObj:IsA("ImageButton")) and guiObj.Visible then
			if not guiObj:IsDescendantOf(ScreenGui) then
				local okCheck, isMatch = pcall(function()
					local bName = string.lower(guiObj.Name)
					local pName = (guiObj.Parent and string.lower(guiObj.Parent.Name)) or ""
					local txt = ""
					if guiObj:IsA("TextButton") then
						txt = string.lower(guiObj.Text or "")
					else
						local childTxt = guiObj:FindFirstChildWhichIsA("TextLabel", true)
						if childTxt then txt = string.lower(childTxt.Text or "") end
					end

					return guiObj:FindFirstAncestor("ProximityPromptUI") ~= nil
						or bName:find("prompt", 1, true) or pName:find("prompt", 1, true)
						or bName:find("action", 1, true) or bName:find("interact", 1, true)
						or txt:find("steal", 1, true) or txt:find("grab", 1, true) or txt:find("take", 1, true)
						or txt:find("collect", 1, true) or txt:find("pick", 1, true) or txt:find("claim", 1, true)
						or txt:find("egg", 1, true) or txt == "e"
				end)

				if okCheck and isMatch then
					tappedCount = tappedCount + 1

					ExecutorSafe.fireSignal(guiObj.Activated)
					ExecutorSafe.fireSignal(guiObj.MouseButton1Down)
					ExecutorSafe.fireSignal(guiObj.MouseButton1Click)
					ExecutorSafe.fireSignal(guiObj.MouseButton1Up)
					ExecutorSafe.fireSignal(guiObj.TouchTap)

					pcall(function()
						local absPos = guiObj.AbsolutePosition
						local absSize = guiObj.AbsoluteSize
						if absPos and absSize and absSize.X > 2 and absSize.Y > 2 then
							local clickX = absPos.X + (absSize.X * 0.5)
							local clickY = absPos.Y + (absSize.Y * 0.5) + inset.Y
							ExecutorSafe.sendMouseClick(clickX, clickY)
						end
					end)
				end
			end
		end
	end

	return tappedCount
end

-- Poin #4: Rate-Limiting Ketat (>= 200ms) pada Smart Remote Fuzzer
local EggFuzzAttempts = setmetatable({}, { __mode = "k" })

local function fireSmartEggRemotes(eggObj, part, promptObj)
	if not Config.SmartRemoteFuzzer then return end
	if State.IsFuzzingRemotes then return end
	if not isValidInstance(eggObj) then return end

	local now = tick()
	if (now - State.LastRemoteFuzzTick) < Config.RemoteBatchCooldown then
		return
	end

	local attempts = EggFuzzAttempts[eggObj] or 0
	if attempts >= 2 then
		return
	end

	State.IsFuzzingRemotes = true
	State.LastRemoteFuzzTick = now
	EggFuzzAttempts[eggObj] = attempts + 1

	spawnManagedThread(function()
		local fired = 0
		for _, rem in ipairs(State.EggRemotes) do
			if not State.ScriptAlive or not State.IsPressingEgg or not isValidInstance(eggObj) then
				break
			end
			if isValidInstance(rem) then
				fired = fired + 1
				if fired > 5 then break end

				if rem:IsA("RemoteEvent") then
					pcall(function() rem:FireServer(eggObj) end)
					task.wait(Config.RemoteSingleDelay)

					if State.IsPressingEgg and isValidInstance(eggObj) then
						pcall(function() rem:FireServer("Steal", eggObj) end)
						task.wait(Config.RemoteSingleDelay)
					end

					if State.IsPressingEgg and isValidInstance(eggObj) then
						pcall(function() rem:FireServer("Collect", eggObj) end)
						task.wait(Config.RemoteSingleDelay)
					end

					if State.IsPressingEgg and isValidInstance(promptObj) then
						pcall(function() rem:FireServer(promptObj) end)
						task.wait(Config.RemoteSingleDelay)
					elseif State.IsPressingEgg and isValidInstance(part) then
						pcall(function() rem:FireServer(part) end)
						task.wait(Config.RemoteSingleDelay)
					end
				elseif rem:IsA("RemoteFunction") then
					spawnManagedThread(function()
						pcall(function() rem:InvokeServer(eggObj) end)
					end)
					task.wait(Config.RemoteSingleDelay)
				end
			end
		end
		State.IsFuzzingRemotes = false
	end)
end

