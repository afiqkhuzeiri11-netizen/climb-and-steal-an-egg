local function isValidInstance(inst)
	return typeof(inst) == "Instance" and inst.Parent ~= nil
end

-- Poin #9: Wrapper Kompatibilitas Executor dengan pcall & Fallback Aman
local ExecutorSafe = {}

function ExecutorSafe.getGuiParent()
	if typeof(gethui) == "function" then
		local ok, res = pcall(gethui)
		if ok and typeof(res) == "Instance" then
			return res
		end
	end
	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and typeof(coreGui) == "Instance" then
		return coreGui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

function ExecutorSafe.fireSignal(signal, ...)
	if not signal then return false end
	local args = { ... }

	if typeof(firesignal) == "function" then
		local ok = pcall(function()
			firesignal(signal, table.unpack(args))
		end)
		if ok then return true end
	end

	if typeof(getconnections) == "function" then
		local ok, list = pcall(getconnections, signal)
		if ok and type(list) == "table" then
			for _, conn in ipairs(list) do
				pcall(function()
					if conn.Fire then
						conn:Fire(table.unpack(args))
					elseif conn.Function then
						task.spawn(conn.Function, table.unpack(args))
					end
				end)
			end
			return true
		end
	end

	return false
end

function ExecutorSafe.fireProximityPrompt(prompt)
	if not isValidInstance(prompt) or not prompt.Enabled then return false end
	if typeof(fireproximityprompt) == "function" then
		local ok = pcall(fireproximityprompt, prompt)
		if ok then return true end
	end
	pcall(function()
		prompt:InputHoldBegin()
		task.delay(math.max(0.05, prompt.HoldDuration or 0), function()
			if isValidInstance(prompt) then
				pcall(function() prompt:InputHoldEnd() end)
			end
		end)
	end)
	return true
end

function ExecutorSafe.fireTouchInterest(toucher, targetPart)
	if not isValidInstance(toucher) or not isValidInstance(targetPart) then return false end
	if typeof(firetouchinterest) == "function" then
		local ok = pcall(function()
			firetouchinterest(toucher, targetPart, 0)
			firetouchinterest(toucher, targetPart, 1)
		end)
		return ok
	end
	return false
end

function ExecutorSafe.fireClickDetector(cd)
	if not isValidInstance(cd) then return false end
	if typeof(fireclickdetector) == "function" then
		local ok = pcall(fireclickdetector, cd)
		return ok
	end
	return false
end

function ExecutorSafe.sendKeyEvent(isDown, keyCode)
	if not VirtualInputManager then return false end
	return pcall(function()
		VirtualInputManager:SendKeyEvent(isDown, keyCode, false, game)
	end)
end

function ExecutorSafe.sendMouseClick(x, y)
	if not VirtualInputManager then return false end
	return pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
		task.wait(0.02)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
	end)
end

-- Poin #2 & #10: Sistem Cleanup Koneksi & Thread Lifecycle Manager
local ConnectionRegistry = {
	Global = {},
	Character = {}
}

local ActiveThreads = {}

local function registerConnection(bucket, key, conn)
	if not conn then return nil end
	if key then
		local existing = bucket[key]
		if existing and typeof(existing) == "RBXScriptConnection" and existing.Connected then
			pcall(function() existing:Disconnect() end)
		end
		bucket[key] = conn
	else
		table.insert(bucket, conn)
	end
	return conn
end

local function addGlobalConn(conn, key)
	return registerConnection(ConnectionRegistry.Global, key, conn)
end

local function addCharConn(conn, key)
	return registerConnection(ConnectionRegistry.Character, key, conn)
end

local function disconnectBucket(bucket)
	for k, conn in pairs(bucket) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then
			pcall(function() conn:Disconnect() end)
		end
		bucket[k] = nil
	end
end

local function cleanupCharacterConnections()
	disconnectBucket(ConnectionRegistry.Character)
end

local function cleanupAllConnections()
	cleanupCharacterConnections()
	disconnectBucket(ConnectionRegistry.Global)
	for i = #ActiveThreads, 1, -1 do
		local th = ActiveThreads[i]
		if typeof(th) == "thread" and coroutine.status(th) == "suspended" then
			pcall(task.cancel, th)
		end
		ActiveThreads[i] = nil
	end
end

local function spawnManagedThread(fn)
	local th = task.spawn(fn)
	table.insert(ActiveThreads, th)
	return th
end

