local function isDepositPadCandidate(obj)
	if not isValidInstance(obj) or not obj:IsA("BasePart") or obj == SafePad then return false end
	local n = string.lower(obj.Name)
	return n:find("deposit", 1, true)
		or n:find("place", 1, true)
		or n:find("deliver", 1, true)
		or n:find("drop", 1, true)
		or n:find("pad", 1, true)
		or n:find("collect", 1, true)
		or n:find("base", 1, true)
		or n:find("stand", 1, true)
end

local function isCandidateWildEgg(obj)
	if not isValidInstance(obj) or obj == SafePad then return false end
	if obj:IsA("Model") or obj:IsA("BasePart") then
		if obj:IsA("BasePart") and isValidInstance(obj.Parent) and obj.Parent:IsA("Model") and obj.Parent ~= Workspace then
			local pn = string.lower(obj.Parent.Name)
			if pn:find(Config.CustomKeyword, 1, true) or pn:find("egg", 1, true) then
				return false
			end
		end

		local n = string.lower(obj.Name)
		local p = (isValidInstance(obj.Parent) and string.lower(obj.Parent.Name)) or ""
		local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
		local hasClick = obj:FindFirstChildWhichIsA("ClickDetector", true) ~= nil

		if n:find(Config.CustomKeyword, 1, true) or p:find("egg", 1, true) or (hasPrompt and (n:find("nest", 1, true) or n:find("spawn", 1, true) or p:find("spawn", 1, true))) or hasClick then
			local part = getPart(obj)
			if isValidInstance(part) and part.Size.Magnitude < 65 then
				return true
			end
		end
	end
	return false
end

local function registerWorkspaceInstance(obj)
	if not isValidInstance(obj) or obj == SafePad then return end
	if obj:IsA("ProximityPrompt") then
		State.TrackedPrompts[obj] = true
		if State.PromptOrigHold[obj] == nil then
			State.PromptOrigHold[obj] = obj.HoldDuration
		end
		if isValidInstance(obj.Parent) and isCandidateWildEgg(obj.Parent) then
			State.TrackedCandidates[obj.Parent] = true
		end
		local mdl = obj:FindFirstAncestorOfClass("Model")
		if isValidInstance(mdl) and isCandidateWildEgg(mdl) then
			State.TrackedCandidates[mdl] = true
		end
	elseif isCandidateWildEgg(obj) then
		State.TrackedCandidates[obj] = true
	end

	if isDepositPadCandidate(obj) then
		State.TrackedDepositPads[obj] = true
	end
end

local function unregisterWorkspaceInstance(obj)
	if not obj then return end
	State.TrackedCandidates[obj] = nil
	State.TrackedPrompts[obj] = nil
	State.TrackedDepositPads[obj] = nil
	State.PromptOrigHold[obj] = nil
	State.VisitedEggs[obj] = nil
end

