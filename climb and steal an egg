-- Fungsi Pemilihan Target Egg Terbaik (Bebas dari Plot Orang Lain)
local function selectBestWildEgg(rootPos)
    refreshEggCache()
    local chosenArea = RarityAreas[Config.SelectedAreaIndex]
    local bestEgg = nil
    local highestMetric = -math.huge

    for _, item in ipairs(State.EggCache) do
        if item.Object and item.Object.Parent and item.Part then
            local isMythicOverride = Config.AutoMythicSniper and (item.RarityId >= 5)
            local isAreaMatch = false

            if chosenArea.Id == 0 or isMythicOverride then
                isAreaMatch = true
            elseif Config.StrictAreaRarityMatch then
                isAreaMatch = (item.RarityId == chosenArea.Id)
            else
                isAreaMatch = (item.RarityId == chosenArea.Id) or (item.ZoneId == chosenArea.Id)
            end

            if isAreaMatch then
                local dist = (rootPos - item.Part.Position).Magnitude
                local metric = Config.PrioritizeHighestRarity and ((item.RarityId * 25000) - dist) or (-dist)
                if metric > highestMetric then
                    highestMetric = metric
                    bestEgg = item
                end
            end
        end
    end

    return bestEgg, chosenArea
end

-- Loop Utama (Mendukung Mode Karakter Diam & Mode Auto Steal Cepat)
task.spawn(function()
    while task.wait(0.22) do
        if not State.AdminDetected then
            -- MODE 1: AUTO COLLECT EGG KARAKTER DIAM (STATIONARY)
            if Config.StationaryCollect then
                pcall(function()
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not root then return end

                    local bestEgg = selectBestWildEgg(root.Position)
                    if bestEgg and bestEgg.Part then
                        LiveStatus.Text = string.format("Collect Diam: Mengambil [%s] %s", bestEgg.Tag, bestEgg.Object.Name)
                        collectEggWhileStandingStill(bestEgg)
                        task.wait(0.25)
                    else
                        LiveStatus.Text = "Collect Diam Aktif: Menunggu Wild Egg baru spawn..."
                    end
                end)

            -- MODE 2: AUTO STEAL BERGERAK & LANGSUNG TELEPORT KE BASE TANPA RAGU
            elseif Config.AutoFarmMove then
                pcall(function()
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if not root or not hum or hum.Health <= 0 then return end

                    local bestEgg, chosenArea = selectBestWildEgg(root.Position)
                    if bestEgg and bestEgg.Part then
                        if Config.TracerBeam then
                            AttachPlayer.WorldPosition = root.Position
                            AttachTarget.WorldPosition = bestEgg.Part.Position
                            TargetBeam.Color = ColorSequence.new(bestEgg.Color)
                            TargetBeam.Enabled = true
                        else
                            TargetBeam.Enabled = false
                        end

                        State.CycleCount = State.CycleCount + 1
                        LiveStatus.Text = string.format("Ambil #%d: [%s] %s", State.CycleCount, bestEgg.Tag, bestEgg.Object.Name)

                        -- 1. Hampiri Telur Liar
                        moveCharacterTo(bestEgg.Part.CFrame + Vector3.new(0, 2.0, 0), Config.InstantSnapToEgg)

                        -- 2. Tandai Cooldown & Ambil Telur Seketika
                        State.VisitedEggs[bestEgg.Object] = tick() + Config.EggCooldownSec
                        fireAllEggTriggers(bestEgg.Object, bestEgg.Part, root)
                        State.CollectedCount = State.CollectedCount + 1
                        task.wait(0.08)

                        -- 3. Langsung Teleport Instan ke Base Tanpa Ragu-ragu!
                        if Config.AutoDepositAfterGrab and Config.AutoFarmMove then
                            instantReturnAndDepositToBase()
                        end
                    else
                        TargetBeam.Enabled = false
                        local standbyCF = Config.CustomStandbyCFrame or (chosenArea.Id > 0 and State.ZoneCheckpoints[chosenArea.Id])
                        if Config.AutoStandbyInArea and standbyCF then
                            if (root.Position - standbyCF.Position).Magnitude > 30 then
                                LiveStatus.Text = "Menuju " .. chosenArea.ShortName .. " (Memuat Area)..."
                                moveCharacterTo(standbyCF, false)
                            else
                                LiveStatus.Text = "Standby di " .. chosenArea.ShortName .. " (Menunggu Wild Egg)..."
                            end
                        end
                    end
                end)
            end
        end
    end
end)

