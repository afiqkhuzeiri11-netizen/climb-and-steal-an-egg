local function setNoclipMode(enabled)
	local char = LocalPlayer.Character
	if not isValidInstance(char) then return end
	if enabled then
		for _, p in ipairs(char:GetDescendants()) do
			if isValidInstance(p) and p:IsA("BasePart") and p ~= SafePad then
				if State.OriginalCollide[p] == nil then
					State.OriginalCollide[p] = p.CanCollide
				end
				p.CanCollide = false
			end
		end
	else
		for p, orig in pairs(State.OriginalCollide) do
			if isValidInstance(p) then
				p.CanCollide = orig
			end
		end
		table.clear(State.OriginalCollide)
	end
end

-- Poin #3: RequestStreamAroundAsync & Kontrol Posisi Aman Anti-Cheat
local function requestStreamSafe(targetPos)
	local done = false
	task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(targetPos, 2.5)
		end)
		done = true
	end)
	local startWait = tick()
	while not done and (tick() - startWait) < 0.35 do
		RunService.Heartbeat:Wait()
	end
end

local function safePositionCharacter(root, hum, targetCF)
	if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then
		return false
	end

	local startPos = root.Position
	local destPos = targetCF.Position
	local dist = (destPos - startPos).Magnitude

	if dist > 65 then
		requestStreamSafe(destPos)
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	-- Micro-stepped CFrame untuk jarak menengah agar tidak memicu flag anti-cheat CFrame snap
	if dist > Config.MaxStepTeleportDist and dist <= 360 then
		local steps = math.clamp(math.ceil(dist / Config.MaxStepTeleportDist), 2, 8)
		for i = 1, steps - 1 do
			if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 or State.CancelGlide then
				return false
			end
			local alpha = i / steps
			local stepPos = startPos:Lerp(destPos, alpha)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.CFrame = CFrame.new(stepPos) * targetCF.Rotation
			RunService.Heartbeat:Wait()
		end
	end

	if isValidInstance(root) and isValidInstance(hum) and hum.Health > 0 then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = targetCF
		RunService.Heartbeat:Wait()
		if isValidInstance(root) then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		return true
	end
	return false
end

-- Poin #1: Pisahkan Logika TweenService dari Heartbeat Velocity
local function moveCharacterTo(targetCF, forceInstantSnap)
	local char = LocalPlayer.Character
	local root = isValidInstance(char) and char:FindFirstChild("HumanoidRootPart")
	local hum = isValidInstance(char) and char:FindFirstChildOfClass("Humanoid")
	if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then
		State.IsGliding = false
		return false
	end

	if State.ActiveTween then
		pcall(function() State.ActiveTween:Cancel() end)
		State.ActiveTween = nil
	end

	local dist = (root.Position - targetCF.Position).Magnitude
	if dist > 60 then
		requestStreamSafe(targetCF.Position)
	end

	if forceInstantSnap or Config.InstantSnapToEgg then
		State.IsGliding = false
		return safePositionCharacter(root, hum, targetCF)
	end

	State.IsGliding = true
	State.CancelGlide = false
	if isValidInstance(SafePad) then
		SafePad.CanCollide = false
	end

	local prevAutoRotate = hum.AutoRotate
	hum.AutoRotate = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	setNoclipMode(true)

	local duration = math.clamp(dist / math.max(30, Config.GlideSpeed), 0.05, 1.45)
	local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		CFrame = targetCF
	})
	State.ActiveTween = tw
	tw:Play()

	local startClock = tick()
	while (tick() - startClock) < duration do
		if State.CancelGlide or not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then
			pcall(function() tw:Cancel() end)
			break
		end
		if tw.PlaybackState == Enum.PlaybackState.Completed or tw.PlaybackState == Enum.PlaybackState.Cancelled then
			break
		end
		RunService.Heartbeat:Wait()
	end

	State.ActiveTween = nil
	State.IsGliding = false

	if isValidInstance(hum) then
		hum.AutoRotate = prevAutoRotate
	end

	if isValidInstance(root) and isValidInstance(hum) and not State.CancelGlide and hum.Health > 0 then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = targetCF
	end

	if not Config.Noclip then
		setNoclipMode(false)
	end

	return true
end

local function executeHyperPressGrab(eggItem)
	local char = LocalPlayer.Character
	local root = isValidInstance(char) and char:FindFirstChild("HumanoidRootPart")
	local hum = isValidInstance(char) and char:FindFirstChildOfClass("Humanoid")
	if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then return false end

	local eggObj = eggItem and eggItem.Object
	local part = eggItem and eggItem.Part
	if not isValidInstance(eggObj) or not isValidInstance(part) then return false end

	if Config.AutoUnequipTools then
		pcall(function() hum:UnequipTools() end)
	end

	local initialCarry = countCarriedObjects()

	local prompts = {}
	local seenPrompt = {}
	for _, d in ipairs(eggObj:GetDescendants()) do
		if isValidInstance(d) and d:IsA("ProximityPrompt") and not seenPrompt[d] then
			seenPrompt[d] = true
			table.insert(prompts, d)
		end
	end
	if isValidInstance(eggObj.Parent) and eggObj.Parent ~= Workspace then
		for _, d in ipairs(eggObj.Parent:GetDescendants()) do
			if isValidInstance(d) and d:IsA("ProximityPrompt") and not seenPrompt[d] then
				seenPrompt[d] = true
				table.insert(prompts, d)
			end
		end
	end
	for pr, _ in pairs(State.TrackedPrompts) do
		if isValidInstance(pr) and not seenPrompt[pr] then
			local parentPart = pr:FindFirstAncestorWhichIsA("BasePart")
				or (pr:FindFirstAncestorOfClass("Model") and getPart(pr:FindFirstAncestorOfClass("Model")))
			if isValidInstance(parentPart) and (parentPart.Position - part.Position).Magnitude <= 10 then
				seenPrompt[pr] = true
				table.insert(prompts, pr)
			end
		elseif not isValidInstance(pr) then
			State.TrackedPrompts[pr] = nil
		end
	end

	local serverHold = 0
	for _, pr in ipairs(prompts) do
		if isValidInstance(pr) then
			if State.PromptOrigHold[pr] == nil then
				State.PromptOrigHold[pr] = pr.HoldDuration
			end
			if State.PromptOrigHold[pr] > serverHold then
				serverHold = State.PromptOrigHold[pr]
			end
			pr.RequiresLineOfSight = false
			pr.MaxActivationDistance = math.max(pr.MaxActivationDistance, 32)
		end
	end

	setNoclipMode(false)
	State.IsGliding = false
	State.IsPressingEgg = true

	local standPos = part.Position + Vector3.new(0, 1.5, 2.2)
	local lookAtEggCF = CFrame.lookAt(standPos, part.Position)
	if isValidInstance(SafePad) then
		SafePad.CanCollide = true
		SafePad.CFrame = CFrame.new(standPos.X, standPos.Y - 3.3, standPos.Z)
	end
	safePositionCharacter(root, hum, lookAtEggCF)

	if Config.AutoAimCameraToEgg and isValidInstance(Camera) then
		local camPos = standPos + Vector3.new(0, 3.5, 6)
		Camera.CFrame = CFrame.lookAt(camPos, part.Position)
	end

	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()

	if isValidInstance(State.ActivePromptShown) and not seenPrompt[State.ActivePromptShown] then
		table.insert(prompts, State.ActivePromptShown)
	end

	for _, pr in ipairs(prompts) do
		if isValidInstance(pr) then
			pcall(function() pr:InputHoldBegin() end)
		end
	end
	ExecutorSafe.sendKeyEvent(true, Enum.KeyCode.E)
	ExecutorSafe.fireTouchInterest(root, part)

	local startHold = tick()
	local requiredWait = serverHold + Config.HoldBufferTime
	local maxTimeout = math.max(Config.MaxGrabWaitTime, requiredWait + 0.8)
	local grabConfirmed = false

	while (tick() - startHold) < maxTimeout do
		if not State.ScriptAlive or not State.IsPressingEgg or not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then
			break
		end
		if not isValidInstance(part) then
			grabConfirmed = true
			break
		end

		local elapsed = tick() - startHold
		if isValidInstance(LiveStatus) and isValidInstance(eggObj) then
			LiveStatus.Text = string.format(
				"Hyper-Press [%s]: Menahan %.1fs / %.1fs...",
				eggObj.Name, elapsed, requiredWait
			)
		end

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if Config.AutoAimCameraToEgg and isValidInstance(Camera) then
			local camPos = root.Position + Vector3.new(0, 3.5, 6)
			Camera.CFrame = CFrame.lookAt(camPos, part.Position)
		end

		if Config.AutoTapPlayerGuiButtons then
			local tapped = tapAllVisibleInteractButtons()
			if tapped > 0 then
				State.LastTriggerMethod = "UI Tap + Hold"
			end
		end

		if isValidInstance(eggObj) then
			for _, cd in ipairs(eggObj:GetDescendants()) do
				if isValidInstance(cd) and cd:IsA("ClickDetector") then
					ExecutorSafe.fireClickDetector(cd)
				end
			end
		end

		if elapsed >= serverHold and Config.UseSignalAndPromptAPI then
			for _, pr in ipairs(prompts) do
				if isValidInstance(pr) then
					ExecutorSafe.fireProximityPrompt(pr)
					ExecutorSafe.fireSignal(pr.Triggered, LocalPlayer)
				end
			end
			State.LastTriggerMethod = "Prompt + Signal"
		end

		if elapsed >= (serverHold * 0.5) then
			fireSmartEggRemotes(eggObj, part, prompts[1])
		end

		if isEggGrabbedOrGone(eggObj, part, initialCarry) then
			grabConfirmed = true
			State.LastTriggerMethod = "6-Layer Verified!"
			break
		end

		task.wait(0.08)
	end

	for _, pr in ipairs(prompts) do
		if isValidInstance(pr) then
			pcall(function() pr:InputHoldEnd() end)
			ExecutorSafe.fireProximityPrompt(pr)
		end
	end
	ExecutorSafe.sendKeyEvent(false, Enum.KeyCode.E)

	State.IsPressingEgg = false
	if isValidInstance(eggObj) then
		State.VisitedEggs[eggObj] = tick() + Config.EggCooldownSec
	end
	return grabConfirmed
end

local function depositCarriedEggToBase()
	local targetDeposit = Config.DepositPadCFrame or Config.BaseCFrame
	if not targetDeposit then return end

	local char = LocalPlayer.Character
	local root = isValidInstance(char) and char:FindFirstChild("HumanoidRootPart")
	local hum = isValidInstance(char) and char:FindFirstChildOfClass("Humanoid")
	if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then return end

	if isValidInstance(LiveStatus) then
		LiveStatus.Text = "Teleport ke Base & Menyetor Telur (Hyper-Deposit)..."
	end
	moveCharacterTo(targetDeposit + Vector3.new(0, 1.8, 0), Config.InstantSnapToBase)
	setNoclipMode(false)

	local beforeCarry = countCarriedObjects()
	local startDep = tick()

	while (tick() - startDep) < Config.DepositStayTime do
		if not State.ScriptAlive or not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then
			break
		end

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if Config.AutoAimCameraToEgg and isValidInstance(Camera) then
			Camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 5, 6), targetDeposit.Position)
		end

		if Config.AutoTapPlayerGuiButtons then
			tapAllVisibleInteractButtons()
		end

		for obj, _ in pairs(State.TrackedDepositPads) do
			if isValidInstance(obj) then
				if (obj.Position - targetDeposit.Position).Magnitude < 18 then
					ExecutorSafe.fireTouchInterest(root, obj)
					local pr = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
					if isValidInstance(pr) and pr.Enabled then
						pr.RequiresLineOfSight = false
						ExecutorSafe.fireProximityPrompt(pr)
					end
				end
			else
				State.TrackedDepositPads[obj] = nil
			end
		end

		if countCarriedObjects() < beforeCarry then
			break
		end

		task.wait(0.08)
	end

	State.CollectedCount = State.CollectedCount + 1
end

