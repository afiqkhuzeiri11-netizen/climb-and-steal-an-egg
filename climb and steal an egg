-- Cek Jumlah Objek/Telur yang Sedang Dibawa Karakter
local function countCarriedObjects()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local count = 0

    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Model") then
                local n = string.lower(child.Name)
                if n:find("egg") or n:find("pet") or n:find("steal") or n:find("carry") or child:FindFirstChildWhichIsA("BasePart") then
                    count = count + 1
                end
            end
        end
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Weld") or desc:IsA("WeldConstraint") or desc:IsA("Motor6D") then
                local p0, p1 = desc.Part0, desc.Part1
                if (p0 and not p0:IsDescendantOf(char)) or (p1 and not p1:IsDescendantOf(char)) then
                    count = count + 2
                end
            end
        end
        for k, v in pairs(char:GetAttributes()) do
            local kn = string.lower(k)
            if (kn:find("carry") or kn:find("egg") or kn:find("holding") or kn:find("stolen")) and v ~= false and v ~= nil and v ~= "" and v ~= 0 then
                count = count + 2
            end
        end
    end

    for k, v in pairs(LocalPlayer:GetAttributes()) do
        local kn = string.lower(k)
        if (kn:find("carry") or kn:find("egg") or kn:find("holding") or kn:find("stolen")) and v ~= false and v ~= nil and v ~= "" and v ~= 0 then
            count = count + 2
        end
    end

    if backpack then
        count = count + #backpack:GetChildren()
    end

    return count
end

local function isEggGrabbedOrGone(eggObj, part, initialCarry)
    local char = LocalPlayer.Character
    if not char then return false end

    if countCarriedObjects() > initialCarry then
        return true
    end
    if eggObj and (eggObj:IsDescendantOf(char) or (LocalPlayer:FindFirstChild("Backpack") and eggObj:IsDescendantOf(LocalPlayer.Backpack))) then
        return true
    end
    if not eggObj or not eggObj.Parent or not part or not part.Parent or part.Transparency >= 0.88 then
        return true
    end

    local pr = eggObj:FindFirstChildWhichIsA("ProximityPrompt", true) or (eggObj.Parent and eggObj.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
    if pr and not pr.Enabled then
        return true
    end

    return false
end

