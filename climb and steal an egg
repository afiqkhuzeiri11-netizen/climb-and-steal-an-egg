local function scanAllPlayerPlotsAndRemotes()
	table.clear(State.PlotCenters)
	table.clear(State.PlotModels)
	table.clear(State.EggRemotes)

	local myName = string.lower(LocalPlayer.Name)
	local myDisp = string.lower(LocalPlayer.DisplayName)
	local playerNames = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local n1 = string.lower(plr.Name)
		local n2 = string.lower(plr.DisplayName)
		if #n1 >= 3 then playerNames[n1] = plr end
		if #n2 >= 3 then playerNames[n2] = plr end
	end

	for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
		if isValidInstance(rem) and (rem:IsA("RemoteEvent") or rem:IsA("RemoteFunction")) then
			local rn = string.lower(rem.Name)
			if rn:find("steal", 1, true) or rn:find("collect", 1, true) or rn:find("grab", 1, true) or rn:find("pickup", 1, true) or rn:find("claim", 1, true) or rn:find("egg", 1, true) or rn:find("take", 1, true) or rn:find("interact", 1, true) then
				table.insert(State.EggRemotes, rem)
			end
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if isValidInstance(obj) then
			registerWorkspaceInstance(obj)

			if obj:IsA("Model") or obj:IsA("Folder") then
				local n = string.lower(obj.Name)
				-- Poin #6: Hanya mendeteksi container plot/base eksplisit di dataran rendah agar tidak salah memblokir spawn telur liar
				if n:find("playerplot", 1, true) or n:find("plot", 1, true) or n:find("tycoon", 1, true) or n:find("hatchery", 1, true) or n:find("baseplot", 1, true) then
					local p = getPart(obj)
					if isValidInstance(p) and p.Position.Y <= (State.MapMinY + 55) then
						State.PlotModels[obj] = true
						table.insert(State.PlotCenters, p.Position)
					end
				end
			end

			if obj:IsA("TextLabel") or obj:IsA("StringValue") or obj:IsA("ObjectValue") then
				local okVal, val = pcall(function()
					if obj:IsA("TextLabel") then
						return string.lower(obj.Text or "")
					elseif obj:IsA("StringValue") then
						return string.lower(obj.Value or "")
					elseif obj:IsA("ObjectValue") and isValidInstance(obj.Value) then
						return string.lower(obj.Value.Name or "")
					end
					return ""
				end)

				if okVal and val and val ~= "" then
					local plotMdl = obj:FindFirstAncestorOfClass("Model")
					local plotPart = isValidInstance(plotMdl) and getPart(plotMdl)

					if isValidInstance(plotMdl) and isValidInstance(plotPart) and plotPart.Position.Y <= (State.MapMinY + 75) then
						if val:find(myName, 1, true) or (#myDisp >= 3 and val:find(myDisp, 1, true)) then
							State.PlotModels[plotMdl] = true
							table.insert(State.PlotCenters, plotPart.Position)
							Config.BaseCFrame = plotPart.CFrame + Vector3.new(0, 3.0, 0)

							for _, sub in ipairs(plotMdl:GetDescendants()) do
								if isValidInstance(sub) and sub:IsA("BasePart") then
									local sn = string.lower(sub.Name)
									if sn:find("deposit", 1, true) or sn:find("place", 1, true) or sn:find("deliver", 1, true) or sn:find("drop", 1, true) or sn:find("pad", 1, true) or sn:find("collect", 1, true) then
										Config.DepositPadCFrame = sub.CFrame + Vector3.new(0, 2.5, 0)
										break
									end
								end
							end
						else
							for pName, _ in pairs(playerNames) do
								if #pName >= 4 and (val == pName or val:find(pName .. "'s", 1, true) or val:find("plot", 1, true) and val:find(pName, 1, true)) then
									State.PlotModels[plotMdl] = true
									table.insert(State.PlotCenters, plotPart.Position)
									break
								end
							end
						end
					end
				end
			end
		end
	end

	if not Config.BaseCFrame then
		local sp = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		Config.BaseCFrame = (isValidInstance(sp) and (sp.CFrame + Vector3.new(0, 3.0, 0)))
			or (isValidInstance(root) and root.CFrame)
			or CFrame.new(0, 20, 0)
	end
	if not Config.DepositPadCFrame then
		Config.DepositPadCFrame = Config.BaseCFrame
	end
end

-- Poin #6: Validasi Plot Pemain Diperketat agar Telur Liar Tidak Ter-skip
local function isEggInsideAnyPlayerPlot(eggObj, part)
	if not Config.IgnoreOtherPlayerPlots then return false end
	if not isValidInstance(eggObj) or not isValidInstance(part) then return false end

	-- 1. Cek hirarki parent terhadap PlotModels yang terverifikasi atau kata kunci kepemilikan eksplisit
	local curr = eggObj
	while isValidInstance(curr) and curr ~= Workspace do
		if State.PlotModels[curr] then
			return true
		end
		local cn = string.lower(curr.Name)
		if cn:find("playerplot", 1, true) or cn:find("placedegg", 1, true) or cn:find("ownedegg", 1, true) or cn:find("incubator", 1, true) or cn:find("hatchery", 1, true) then
			return true
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			local pName = string.lower(plr.Name)
			if #pName >= 3 and (cn == pName or cn == (pName .. "_plot") or cn == ("plot_" .. pName)) then
				return true
			end
		end
		curr = curr.Parent
	end

	-- 2. Cek atribut kepemilikan eksplisit pada telur
	local okAttr, attrs = pcall(function() return eggObj:GetAttributes() end)
	if okAttr and type(attrs) == "table" then
		for attrName, attrVal in pairs(attrs) do
			local an = string.lower(tostring(attrName))
			if an == "owner" or an == "ownerid" or an == "userid" or an == "placed" or an == "plotowner" then
				if attrVal ~= nil and attrVal ~= false and attrVal ~= "" and attrVal ~= 0 then
					return true
				end
			end
		end
	end

	-- 3. Cek ProximityPrompt atau TextLabel indikator telur yang sudah ditaruh di base
	for _, d in ipairs(eggObj:GetDescendants()) do
		if isValidInstance(d) then
			if d:IsA("ProximityPrompt") then
				local act = string.lower((d.ActionText or "") .. " " .. (d.ObjectText or ""))
				if act:find("sell", 1, true) or act:find("hatch", 1, true) or act:find("remove", 1, true) or act:find("upgrade", 1, true) or act:find("lock", 1, true) then
					return true
				end
			elseif d:IsA("TextLabel") then
				local tl = string.lower(d.Text or "")
				if tl:find("/s", 1, true) or tl:find("$/", 1, true) or tl:find("income", 1, true) or tl:find("owned by", 1, true) or tl:find("hatching", 1, true) then
					return true
				end
			end
		end
	end

	-- 4. Cek radius horizontal & vertikal ketat hanya di sekitar plot dasar
	for _, plotPos in ipairs(State.PlotCenters) do
		local hDist = (Vector2.new(part.Position.X, part.Position.Z) - Vector2.new(plotPos.X, plotPos.Z)).Magnitude
		local vDiff = part.Position.Y - plotPos.Y
		if hDist <= Config.PlotSafeRadius and vDiff >= -10 and vDiff <= 18 then
			return true
		end
	end

	return false
end

-- Poin #5: Fungsi Parsing String Zona/Rarity dengan pcall & Fallback Default Cerdas
local function matchAreaIdFromText(str)
	local ok, result = pcall(function()
		if type(str) ~= "string" or str == "" then return nil end
		local s = string.lower(str)
		for i = #RarityAreas, 2, -1 do
			local area = RarityAreas[i]
			if area and type(area.Keywords) == "table" then
				for _, kw in ipairs(area.Keywords) do
					if type(kw) == "string" and kw ~= "" and s:find(string.lower(kw), 1, true) then
						return area.Id
					end
				end
			end
		end
		return nil
	end)
	if ok then
		return result
	end
	return nil
end

local function getEggRarityAndZone(eggObj, part)
	local fallbackArea = RarityAreas[2] -- Default ke Area 1: Common Zone
	if not isValidInstance(eggObj) or not isValidInstance(part) then
		return 1, 1, fallbackArea.ShortName, fallbackArea.Color
	end

	local ok, rId, zId, shortName, color = pcall(function()
		local chunks = { string.lower(eggObj.Name or "") }
		local parent = eggObj.Parent
		local depth = 0
		while isValidInstance(parent) and parent ~= Workspace and depth < 6 do
			depth = depth + 1
			table.insert(chunks, string.lower(parent.Name or ""))
			parent = parent.Parent
		end

		local okAttrs, attrs = pcall(function() return eggObj:GetAttributes() end)
		if okAttrs and type(attrs) == "table" then
			for _, attrVal in pairs(attrs) do
				if type(attrVal) == "string" then
					table.insert(chunks, string.lower(attrVal))
				end
			end
		end

		for _, d in ipairs(eggObj:GetDescendants()) do
			if isValidInstance(d) then
				if d:IsA("TextLabel") and type(d.Text) == "string" then
					table.insert(chunks, string.lower(d.Text))
				elseif d:IsA("StringValue") and type(d.Value) == "string" then
					table.insert(chunks, string.lower(d.Value))
				end
			end
		end

		local combined = table.concat(chunks, " ")
		local textAreaId = matchAreaIdFromText(combined)

		local span = math.max(100, (State.MapMaxY or 600) - (State.MapMinY or 0))
		local ratioY = math.clamp((part.Position.Y - (State.MapMinY or 0)) / span, 0, 1)
		local heightZoneId = 1
		for i = 2, #RarityAreas do
			local a = RarityAreas[i]
			if a and ratioY >= a.HeightMin and ratioY <= (a.HeightMax + 0.05) then
				heightZoneId = a.Id
			end
		end

		local finalRarityId = textAreaId or heightZoneId or 1
		local areaEntry = RarityAreas[finalRarityId + 1] or fallbackArea
		return finalRarityId, heightZoneId, areaEntry.ShortName, areaEntry.Color
	end)

	if ok and rId and zId and shortName and color then
		return rId, zId, shortName, color
	end
	return 1, 1, fallbackArea.ShortName, fallbackArea.Color
end

local function calibrateMapRarityAreas()
	local minY, maxY = math.huge, -math.huge
	local detectedZones = {}
	local collidableParts = {}

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if isValidInstance(obj) then
			registerWorkspaceInstance(obj)

			if obj:IsA("BasePart") and obj ~= SafePad then
				local pos = obj.Position
				if pos.Y > -200 and pos.Y < 40000 and obj.Size.Magnitude < 650 then
					local n = string.lower(obj.Name)
					local p = (isValidInstance(obj.Parent) and string.lower(obj.Parent.Name)) or ""
					if n:find("egg", 1, true) or n:find("nest", 1, true) or n:find("stage", 1, true) or n:find("area", 1, true) or n:find("zone", 1, true) or p:find("egg", 1, true) or p:find("stage", 1, true) or p:find("area", 1, true) then
						if pos.Y < minY then minY = pos.Y end
						if pos.Y > maxY then maxY = pos.Y end
					end

					local areaId = matchAreaIdFromText(obj.Name .. " " .. p)
					if areaId and not detectedZones[areaId] then
						detectedZones[areaId] = obj.CFrame + Vector3.new(0, 3.5, 0)
					end

					if obj.CanCollide and obj.Size.Magnitude < 450 then
						table.insert(collidableParts, obj)
					end
				end
			end
		end
	end

	if minY == math.huge then minY = 0 end
	if maxY == -math.huge or maxY <= minY then maxY = minY + 600 end

	State.MapMinY = minY
	State.MapMaxY = maxY

	local spanY = math.max(100, maxY - minY)
	for idx = 2, #RarityAreas do
		local area = RarityAreas[idx]
		if detectedZones[area.Id] then
			State.ZoneCheckpoints[area.Id] = detectedZones[area.Id]
		else
			local midY = minY + (spanY * ((area.HeightMin + area.HeightMax) / 2))
			local bestPart, bestDiff = nil, math.huge
			for _, obj in ipairs(collidableParts) do
				if isValidInstance(obj) and obj.Position.Y >= minY and obj.Position.Y <= maxY + 30 then
					local diff = math.abs(obj.Position.Y - midY)
					if diff < bestDiff then
						bestDiff = diff
						bestPart = obj
					end
				end
			end
			if isValidInstance(bestPart) then
				State.ZoneCheckpoints[area.Id] = bestPart.CFrame + Vector3.new(0, 3.5, 0)
			end
		end
	end

	scanAllPlayerPlotsAndRemotes()
end

spawnManagedThread(function()
	task.wait(1)
	recordStarterTools()
	calibrateMapRarityAreas()
end)

local function isWildEggReady(eggObj, part)
	if not isValidInstance(eggObj) or not isValidInstance(part) then
		return false
	end

	if Config.SkipRecentlyVisited then
		local exp = State.VisitedEggs[eggObj]
		if exp and tick() < exp then
			return false
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if isValidInstance(plr.Character) and (eggObj:IsDescendantOf(plr.Character) or part:IsDescendantOf(plr.Character)) then
			return false
		end
	end

	if isEggInsideAnyPlayerPlot(eggObj, part) then
		return false
	end

	if Config.OnlyActiveWildEggs then
		if part.Transparency >= 0.9 then
			return false
		end
		local pr = eggObj:FindFirstChildWhichIsA("ProximityPrompt", true)
			or (isValidInstance(eggObj.Parent) and eggObj.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
		if isValidInstance(pr) and not pr.Enabled then
			return false
		end
	end

	return true
end

local function refreshEggCache()
	local now = tick()
	for eggInst, expTime in pairs(State.VisitedEggs) do
		if not isValidInstance(eggInst) or now >= expTime then
			State.VisitedEggs[eggInst] = nil
		end
	end

	table.clear(State.EggCache)
	for obj, _ in pairs(State.TrackedCandidates) do
		if not isValidInstance(obj) then
			State.TrackedCandidates[obj] = nil
		elseif isCandidateWildEgg(obj) then
			local part = getPart(obj)
			if isValidInstance(part) and isWildEggReady(obj, part) then
				local rId, zId, tag, col = getEggRarityAndZone(obj, part)
				table.insert(State.EggCache, {
					Object = obj,
					Part = part,
					RarityId = rId,
					ZoneId = zId,
					Tag = tag,
					Color = col
				})
			end
		end
	end

	if isValidInstance(LiveStatus) then
		LiveStatus.Text = string.format(
			"Wild Egg: %d | Metode: %s | Terkumpul: %d",
			#State.EggCache, State.LastTriggerMethod, State.CollectedCount
		)
	end
end

