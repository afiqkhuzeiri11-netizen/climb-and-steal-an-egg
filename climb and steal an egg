local function scanAllPlayerPlotsAndRemotes()
    table.clear(State.PlotCenters)
    table.clear(State.PlotModels)
    table.clear(State.EggRemotes)

    local myName = string.lower(LocalPlayer.Name)
    local myDisp = string.lower(LocalPlayer.DisplayName)
    local playerNames = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        playerNames[string.lower(plr.Name)] = plr
        playerNames[string.lower(plr.DisplayName)] = plr
    end

    -- Scan semua Remote di ReplicatedStorage & Workspace
    for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
        if rem:IsA("RemoteEvent") or rem:IsA("RemoteFunction") then
            local rn = string.lower(rem.Name)
            if rn:find("steal") or rn:find("collect") or rn:find("grab") or rn:find("pickup") or rn:find("claim") or rn:find("egg") or rn:find("take") or rn:find("interact") then
                table.insert(State.EggRemotes, rem)
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local n = string.lower(obj.Name)
            if n:find("plot") or n:find("base") or n:find("tycoon") or n:find("stand") or n:find("camp") or n:find("hatchery") or n:find("slot") then
                local p = getPart(obj)
                if p and p.Position.Y < (State.MapMinY + 85) then
                    State.PlotModels[obj] = true
                    table.insert(State.PlotCenters, p.Position)
                end
            end
        end

        if obj:IsA("TextLabel") or obj:IsA("StringValue") or obj:IsA("ObjectValue") then
            local val = obj:IsA("TextLabel") and string.lower(obj.Text) or string.lower(tostring(obj.Value))
            if val ~= "" then
                local plotMdl = obj:FindFirstAncestorOfClass("Model")
                local plotPart = plotMdl and getPart(plotMdl)

                if val:find(myName, 1, true) or val:find(myDisp, 1, true) then
                    if plotMdl and plotPart then
                        State.PlotModels[plotMdl] = true
                        table.insert(State.PlotCenters, plotPart.Position)
                        Config.BaseCFrame = plotPart.CFrame + Vector3.new(0, 3.0, 0)

                        for _, sub in ipairs(plotMdl:GetDescendants()) do
                            if sub:IsA("BasePart") then
                                local sn = string.lower(sub.Name)
                                if sn:find("deposit") or sn:find("place") or sn:find("deliver") or sn:find("drop") or sn:find("pad") or sn:find("collect") then
                                    Config.DepositPadCFrame = sub.CFrame + Vector3.new(0, 2.5, 0)
                                    break
                                end
                            end
                        end
                    end
                else
                    for pName, _ in pairs(playerNames) do
                        if #pName >= 3 and val:find(pName, 1, true) then
                            if plotMdl and plotPart then
                                State.PlotModels[plotMdl] = true
                                table.insert(State.PlotCenters, plotPart.Position)
                            end
                            break
                        end
                    end
                end
            end
        end
    end

    if not Config.BaseCFrame then
        local sp = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        Config.BaseCFrame = sp and (sp.CFrame + Vector3.new(0, 3.0, 0)) or (root and root.CFrame or CFrame.new(0, 20, 0))
    end
    if not Config.DepositPadCFrame then
        Config.DepositPadCFrame = Config.BaseCFrame
    end
end

local function isEggInsideAnyPlayerPlot(eggObj, part)
    if not Config.IgnoreOtherPlayerPlots then return false end

    local curr = eggObj
    while curr and curr ~= Workspace do
        if State.PlotModels[curr] then return true end
        local cn = string.lower(curr.Name)
        if cn:find("plot") or cn:find("base") or cn:find("placed") or cn:find("owned") or cn:find("incubator") or cn:find("hatch") or cn:find("stand") or cn:find("slot") or cn:find("camp") then
            return true
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if cn == string.lower(plr.Name) or cn == string.lower(plr.DisplayName) then
                return true
            end
        end
        curr = curr.Parent
    end

    for attrName, attrVal in pairs(eggObj:GetAttributes()) do
        local an = string.lower(attrName)
        if an:find("owner") or an:find("placed") or an:find("plot") or an:find("claimed") or an:find("userid") or an:find("holder") then
            if attrVal ~= nil and attrVal ~= false and attrVal ~= "" and attrVal ~= 0 then
                return true
            end
        end
    end

    for _, d in ipairs(eggObj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local act = string.lower(d.ActionText .. " " .. d.ObjectText)
            if act:find("sell") or act:find("hatch") or act:find("remove") or act:find("upgrade") or act:find("lock") then
                return true
            end
        elseif d:IsA("TextLabel") then
            local tl = string.lower(d.Text)
            if tl:find("/s") or tl:find("$/") or tl:find("income") or tl:find("owned by") then
                return true
            end
        end
    end

    for _, plotPos in ipairs(State.PlotCenters) do
        local hDist = (Vector2.new(part.Position.X, part.Position.Z) - Vector2.new(plotPos.X, plotPos.Z)).Magnitude
        local vDiff = math.abs(part.Position.Y - plotPos.Y)
        if hDist <= Config.PlotSafeRadius and vDiff <= 35 then
            return true
        end
    end

    return false
end

local function matchAreaIdFromText(str)
    local s = string.lower(tostring(str or ""))
    for i = #RarityAreas, 2, -1 do
        local area = RarityAreas[i]
        for _, kw in ipairs(area.Keywords) do
            if s:find(string.lower(kw), 1, true) then
                return area.Id
            end
        end
    end
    return nil
end

local function calibrateMapRarityAreas()
    local minY, maxY = math.huge, -math.huge
    local detectedZones = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and State.PromptOrigHold[obj] == nil then
            State.PromptOrigHold[obj] = obj.HoldDuration
        end

        if obj:IsA("BasePart") and obj.Name ~= "OverdriveV8SafePad" then
            if obj.Position.Y > -200 and obj.Position.Y < 40000 and obj.Size.Magnitude < 650 then
                local n = string.lower(obj.Name)
                local p = obj.Parent and string.lower(obj.Parent.Name) or ""
                if n:find("egg") or n:find("nest") or n:find("stage") or n:find("area") or n:find("zone") or p:find("egg") or p:find("stage") or p:find("area") then
                    if obj.Position.Y < minY then minY = obj.Position.Y end
                    if obj.Position.Y > maxY then maxY = obj.Position.Y end
                end

                local areaId = matchAreaIdFromText(obj.Name .. " " .. p)
                if areaId and not detectedZones[areaId] then
                    detectedZones[areaId] = obj.CFrame + Vector3.new(0, 3.5, 0)
                end
            end
        end
    end

    if minY == math.huge then minY = 0 end
    if maxY == -math.huge or maxY <= minY then maxY = minY + 600 end

    State.MapMinY = minY
    State.MapMaxY = maxY

    local spanY = math.max(100, maxY - minY)
    for idx = 2, #RarityAreas do
        local area = RarityAreas[idx]
        if detectedZones[area.Id] then
            State.ZoneCheckpoints[area.Id] = detectedZones[area.Id]
        else
            local midY = minY + (spanY * ((area.HeightMin + area.HeightMax) / 2))
            local bestPart, bestDiff = nil, math.huge
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.CanCollide and obj.Size.Magnitude < 450 and obj.Position.Y >= minY and obj.Position.Y <= maxY + 30 then
                    local diff = math.abs(obj.Position.Y - midY)
                    if diff < bestDiff then
                        bestDiff = diff
                        bestPart = obj
                    end
                end
            end
            if bestPart then
                State.ZoneCheckpoints[area.Id] = bestPart.CFrame + Vector3.new(0, 3.5, 0)
            end
        end
    end

    scanAllPlayerPlotsAndRemotes()
end

task.spawn(function()
    task.wait(1)
    calibrateMapRarityAreas()
end)

local function isWildEggReady(eggObj, part)
    if not eggObj or not eggObj.Parent or not part or not part.Parent then
        return false
    end

    if Config.SkipRecentlyVisited then
        local exp = State.VisitedEggs[eggObj]
        if exp and tick() < exp then
            return false
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and (eggObj:IsDescendantOf(plr.Character) or part:IsDescendantOf(plr.Character)) then
            return false
        end
    end

    if isEggInsideAnyPlayerPlot(eggObj, part) then
        return false
    end

    if Config.OnlyActiveWildEggs then
        if part.Transparency >= 0.9 then
            return false
        end
        local pr = eggObj:FindFirstChildWhichIsA("ProximityPrompt", true) or (eggObj.Parent and eggObj.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
        if pr and not pr.Enabled then
            return false
        end
    end

    return true
end

local function getEggRarityAndZone(eggObj, part)
    local combined = string.lower(eggObj.Name)
    local parent = eggObj.Parent
    while parent and parent ~= Workspace do
        combined = combined .. " " .. string.lower(parent.Name)
        parent = parent.Parent
    end

    for _, attrVal in pairs(eggObj:GetAttributes()) do
        if type(attrVal) == "string" then
            combined = combined .. " " .. string.lower(attrVal)
        end
    end

    for _, d in ipairs(eggObj:GetDescendants()) do
        if d:IsA("TextLabel") then combined = combined .. " " .. string.lower(d.Text)
        elseif d:IsA("StringValue") then combined = combined .. " " .. string.lower(d.Value) end
    end

    local textAreaId = matchAreaIdFromText(combined)
    local ratioY = math.clamp((part.Position.Y - State.MapMinY) / math.max(100, State.MapMaxY - State.MapMinY), 0, 1)
    local heightZoneId = 1
    for i = 2, #RarityAreas do
        local a = RarityAreas[i]
        if ratioY >= a.HeightMin and ratioY <= a.HeightMax + 0.05 then
            heightZoneId = a.Id
        end
    end

    local finalRarityId = textAreaId or heightZoneId
    local areaEntry = RarityAreas[finalRarityId + 1] or RarityAreas[2]
    return finalRarityId, heightZoneId, areaEntry.ShortName, areaEntry.Color
end

local function isCandidateWildEgg(obj)
    if not obj or not obj.Parent then return false end
    if obj:IsA("Model") or obj:IsA("BasePart") then
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") and obj.Parent ~= Workspace then
            local pn = string.lower(obj.Parent.Name)
            if pn:find(Config.CustomKeyword, 1, true) or pn:find("egg", 1, true) then
                return false
            end
        end

        local n = string.lower(obj.Name)
        local p = obj.Parent and string.lower(obj.Parent.Name) or ""
        local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
        local hasClick = obj:FindFirstChildWhichIsA("ClickDetector", true) ~= nil

        if n:find(Config.CustomKeyword, 1, true) or p:find("egg", 1, true) or (hasPrompt and (n:find("nest") or n:find("spawn") or p:find("spawn"))) or hasClick then
            local part = getPart(obj)
            if part and part.Size.Magnitude < 65 then
                return true
            end
        end
    end
    return false
end

local function refreshEggCache()
    local now = tick()
    for eggInst, expTime in pairs(State.VisitedEggs) do
        if not eggInst or not eggInst.Parent or now >= expTime then
            State.VisitedEggs[eggInst] = nil
        end
    end

    table.clear(State.EggCache)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isCandidateWildEgg(obj) then
            local part = getPart(obj)
            if part and isWildEggReady(obj, part) then
                local rId, zId, tag, col = getEggRarityAndZone(obj, part)
                table.insert(State.EggCache, {
                    Object = obj,
                    Part = part,
                    RarityId = rId,
                    ZoneId = zId,
                    Tag = tag,
                    Color = col
                })
            end
        end
    end

    LiveStatus.Text = string.format(
        "Wild Egg: %d | Metode: %s | Terkumpul: %d",
        #State.EggCache, State.LastTriggerMethod, State.CollectedCount
    )
end

