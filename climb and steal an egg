	ExecutorSafe.sendKeyEvent(false, Enum.KeyCode.E)
	if isValidInstance(State.ActivePromptShown) then
		pcall(function() State.ActivePromptShown:InputHoldEnd() end)
	end

	if isValidInstance(SafePad) then
		SafePad.CanCollide = false
		SafePad.CFrame = CFrame.new(0, -9999, 0)
	end

	table.clear(State.OriginalCollide)
end

