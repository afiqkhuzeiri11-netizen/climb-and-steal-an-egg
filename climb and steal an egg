local function selectBestWildEgg(rootPos)
    refreshEggCache()
    local chosenArea = RarityAreas[Config.SelectedAreaIndex]
    local bestEgg = nil
    local highestMetric = -math.huge

    for _, item in ipairs(State.EggCache) do
        if item.Object and item.Object.Parent and item.Part then
            local isMythicOverride = Config.AutoMythicSniper and (item.RarityId >= 5)
            local isAreaMatch = false

            if chosenArea.Id == 0 or isMythicOverride then
                isAreaMatch = true
            elseif Config.StrictAreaRarityMatch then
                isAreaMatch = (item.RarityId == chosenArea.Id)
            else
                isAreaMatch = (item.RarityId == chosenArea.Id) or (item.ZoneId == chosenArea.Id)
            end

            if isAreaMatch then
                local dist = (rootPos - item.Part.Position).Magnitude
                local metric = Config.PrioritizeHighestRarity and ((item.RarityId * 25000) - dist) or (-dist)
                if metric > highestMetric then
                    highestMetric = metric
                    bestEgg = item
                end
            end
        end
    end

    return bestEgg, chosenArea
end

