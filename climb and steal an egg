local function getPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

-- LAYER 3: Menekan semua tombol UI yang muncul di PlayerGui / ProximityPromptUI / BillboardGui (firesignal + Touch/Mouse Tap)
local function tapAllVisibleInteractButtons()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return 0 end

    local tappedCount = 0
    local inset = GuiService:GetGuiInset()

    for _, guiObj in ipairs(pGui:GetDescendants()) do
        if (guiObj:IsA("TextButton") or guiObj:IsA("ImageButton")) and guiObj.Visible then
            local bName = string.lower(guiObj.Name)
            local pName = guiObj.Parent and string.lower(guiObj.Parent.Name) or ""
            local txt = ""
            if guiObj:IsA("TextButton") then
                txt = string.lower(guiObj.Text)
            else
                local childTxt = guiObj:FindFirstChildWhichIsA("TextLabel", true)
                if childTxt then txt = string.lower(childTxt.Text) end
            end

            local isPromptUI = guiObj:FindFirstAncestor("ProximityPromptUI") ~= nil
                or bName:find("prompt") or pName:find("prompt")
                or bName:find("action") or bName:find("interact")
                or txt:find("steal") or txt:find("grab") or txt:find("take")
                or txt:find("collect") or txt:find("pick") or txt:find("claim")
                or txt:find("egg") or txt == "e"

            -- Jangan pencet tombol GUI script kita sendiri
            if isPromptUI and not guiObj:IsDescendantOf(ScreenGui) then
                tappedCount = tappedCount + 1

                -- 1. Panggil firesignal & getconnections jika didukung oleh Delta Executor
                if firesignal then
                    pcall(function() firesignal(guiObj.Activated) end)
                    pcall(function() firesignal(guiObj.MouseButton1Down) end)
                    pcall(function() firesignal(guiObj.MouseButton1Click) end)
                    pcall(function() firesignal(guiObj.MouseButton1Up) end)
                    pcall(function() firesignal(guiObj.TouchTap) end)
                end

                if getconnections then
                    for _, sig in ipairs({guiObj.Activated, guiObj.MouseButton1Click, guiObj.MouseButton1Down, guiObj.TouchTap}) do
                        pcall(function()
                            for _, conn in ipairs(getconnections(sig)) do
                                if conn.Fire then conn:Fire() end
                            end
                        end)
                    end
                end

                -- 2. Simulasi Klik Layar Asli tepat di tengah koordinat tombol UI tersebut
                local absPos = guiObj.AbsolutePosition
                local absSize = guiObj.AbsoluteSize
                if absSize.X > 5 and absSize.Y > 5 then
                    local clickX = absPos.X + (absSize.X / 2)
                    local clickY = absPos.Y + (absSize.Y / 2) + inset.Y
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
                        task.wait(0.02)
                        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
                    end)
                end
            end
        end
    end

    return tappedCount
end

-- LAYER 5: Smart Remote Argument Fuzzer (Menembak Remote pengambilan telur dengan berbagai pola argumen game)
local function fireSmartEggRemotes(eggObj, part, promptObj)
    if not Config.SmartRemoteFuzzer then return end

    for _, rem in ipairs(State.EggRemotes) do
        if rem and rem.Parent then
            if rem:IsA("RemoteEvent") then
                pcall(function() rem:FireServer(eggObj) end)
                pcall(function() rem:FireServer(part) end)
                pcall(function() rem:FireServer(eggObj.Name) end)
                pcall(function() rem:FireServer("Steal", eggObj) end)
                pcall(function() rem:FireServer("Collect", eggObj) end)
                pcall(function() rem:FireServer("Grab", eggObj) end)
                if promptObj then
                    pcall(function() rem:FireServer(promptObj) end)
                end
