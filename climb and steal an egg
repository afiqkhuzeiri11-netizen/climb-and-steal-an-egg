		else
			SafePad.CanCollide = false
			SafePad.CFrame = CFrame.new(0, -9999, 0)
		end
	end

	if Config.AntiVoid and root.Position.Y < (Workspace.FallenPartsDestroyHeight + 30) then
		forceResetCharacterState()
		safePositionCharacter(root, hum, (Config.BaseCFrame or CFrame.new(0, 35, 0)) + Vector3.new(0, 4, 0))
	end

	if Config.SpeedBoost and not State.IsPressingEgg and not State.IsGliding then
		hum.WalkSpeed = Config.WalkSpeed
	end
	if Config.HighJump then
		hum.UseJumpPower = true
		hum.JumpPower = Config.JumpPower
	end
end), "MainHeartbeat")

