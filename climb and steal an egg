local function getPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function parseEggRarity(eggObj)
    local combinedText = string.lower(eggObj.Name)
    if eggObj.Parent then
        combinedText = combinedText .. " " .. string.lower(eggObj.Parent.Name)
    end

    -- Cek Attribute Rarity
    for attrName, attrVal in pairs(eggObj:GetAttributes()) do
        if type(attrVal) == "string" then
            combinedText = combinedText .. " " .. string.lower(attrVal)
        end
    end

    -- Cek teks di dalam BillboardGui / TextLabel pada Telur
    for _, desc in ipairs(eggObj:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("StringValue") then
            local val = desc:IsA("TextLabel") and desc.Text or desc.Value
            combinedText = combinedText .. " " .. string.lower(tostring(val))
        end
    end

    if combinedText:find("secret") or combinedText:find("mythic") or combinedText:find("divine") or combinedText:find("god") or combinedText:find("anime") or combinedText:find("void") then
        return 5, "MYTHIC/SECRET", Color3.fromRGB(255, 45, 95)
    elseif combinedText:find("legend") or combinedText:find("gold") or combinedText:find("dragon") or combinedText:find("royal") then
        return 4, "LEGENDARY", Color3.fromRGB(255, 195, 0)
    elseif combinedText:find("epic") or combinedText:find("crystal") or combinedText:find("demon") or combinedText:find("dark") then
        return 3, "EPIC", Color3.fromRGB(185, 75, 255)
    elseif combinedText:find("rare") or combinedText:find("uncommon") or combinedText:find("silver") or combinedText:find("blue") then
        return 2, "RARE", Color3.fromRGB(0, 180, 255)
    else
        return 1, "COMMON", Color3.fromRGB(210, 210, 210)
    end
end

local function isEggCandidate(obj)
    if not obj or not obj.Parent then return false end
    local char = LocalPlayer.Character
    if char and obj:IsDescendantOf(char) then return false end
    if obj:IsA("Model") or obj:IsA("BasePart") then
        local n = string.lower(obj.Name)
        local p = obj.Parent and string.lower(obj.Parent.Name) or ""
        if n:find("egg") or p:find("egg") or obj:FindFirstChildWhichIsA("ProximityPrompt", true) and (n:find("pet") or n:find("nest") or p:find("spawn")) then
            local part = getPart(obj)
            if part and part.Size.Magnitude < 60 then
                return true
            end
        end
    end
    return false
end

local function scanEggs()
    table.clear(EggCache)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isEggCandidate(obj) then
            local score, label, col = parseEggRarity(obj)
            table.insert(EggCache, {
                Object = obj,
                Part = getPart(obj),
                Score = score,
                RarityName = label,
                Color = col
            })
        end
    end
end

-- Mencari Posisi Puncak / Level Final di Map
local function findFinalSummitCFrame()
    local highestY = -math.huge
    local bestPart = nil

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            local p = obj.Parent and string.lower(obj.Parent.Name) or ""
            -- Prioritaskan objek bertuliskan final/top/summit/end/nest dengan posisi tinggi
            if (n:find("final") or n:find("summit") or n:find("top") or n:find("win") or n:find("nest") or n:find("egg") or p:find("stage") or p:find("checkpoint")) then
                if obj.Position.Y > highestY and obj.Position.Y < 50000 and obj.Size.Magnitude < 300 then
                    highestY = obj.Position.Y
                    bestPart = obj
                end
            end
        end
    end

    -- Jika tidak ada nama khusus, ambil posisi telur paling tinggi di map
    if not bestPart then
        scanEggs()
        for _, data in ipairs(EggCache) do
            if data.Part and data.Part.Position.Y > highestY then
                highestY = data.Part.Position.Y
                bestPart = data.Part
            end
        end
    end

    if bestPart then
        return bestPart.CFrame + Vector3.new(0, 4, 0), math.floor(highestY)
    end
    return nil, 0
end

