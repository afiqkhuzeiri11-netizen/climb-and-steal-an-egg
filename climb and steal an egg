-- 7. DETEKSI ADMIN & LOOP UTAMA AUTO FARM
-- ==========================================
local function verifyAdminSafety()
    if not Config.AntiAdmin then
        AdminPaused = false
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local n = string.lower(plr.Name)
            if n:find("admin") or n:find("mod") or n:find("dev") or n:find("owner") then
                AdminPaused = true
                StatusLabel.Text = "PAUSE AMAN: Admin Terdeteksi di Server!"
                return
            end
        end
    end
    AdminPaused = false
end

Players.PlayerAdded:Connect(verifyAdminSafety)
Players.PlayerRemoving:Connect(verifyAdminSafety)

-- Loop Utama Auto Climb & Steal Egg
task.spawn(function()
    while task.wait(0.35) do
        if Config.AutoSteal and not AdminPaused then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum or hum.Health <= 0 then return end

                scanEggs()
                local minScore = RarityList[Config.RarityIndex].MinScore
                local chosenEgg = nil
                local bestMetric = -math.huge

                for _, data in ipairs(EggCache) do
                    if data.Object and data.Object.Parent and data.Part and data.Score >= minScore then
                        local dist = (root.Position - data.Part.Position).Magnitude
                        -- Jika prioritas rarity aktif, utamakan skor rarity tertinggi lalu jarak terdekat
                        local metric = Config.PrioritizeHighestRarity and ((data.Score * 10000) - dist) or (-dist)
                        if metric > bestMetric then
                            bestMetric = metric
                            chosenEgg = data
                        end
                    end
                end

                if chosenEgg and chosenEgg.Part then
                    StatusLabel.Text = "Mencuri [" .. chosenEgg.RarityName .. "] " .. chosenEgg.Object.Name
                    safeGlideTo(chosenEgg.Part.CFrame + Vector3.new(0, 2.5, 0))
                    executeEggSteal(chosenEgg.Object)
                    task.wait(0.25)

                    -- Jika Auto Return Base aktif, langsung antar telur kembali ke base
                    if Config.AutoReturnBase and Config.SavedBaseCFrame then
                        StatusLabel.Text = "Mengantar telur kembali ke Base..."
                        safeGlideTo(Config.SavedBaseCFrame + Vector3.new(0, 2.5, 0))
                        task.wait(0.4)
                    end
                else
                    StatusLabel.Text = "Menunggu telur [" .. RarityList[Config.RarityIndex].Name .. "] spawn..."
                end
            end)
        end
    end
end)

-- Loop Visual ESP + Label Rarity
task.spawn(function()
    while task.wait(1.2) do
        if Config.ESP then
            pcall(function()
                scanEggs()
                for _, data in ipairs(EggCache) do
                    local obj = data.Object
                    local part = data.Part
                    if obj and part then
                        if not obj:FindFirstChild("AnimeEggESP") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "AnimeEggESP"
                            hl.FillColor = data.Color
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.35
                            hl.Parent = obj
                        end
                        if not part:FindFirstChild("AnimeEggTag") then
                            local bb = Instance.new("BillboardGui")
                            bb.Name = "AnimeEggTag"
                            bb.Size = UDim2.new(0, 120, 0, 30)
                            bb.StudsOffset = Vector3.new(0, 3, 0)
                            bb.AlwaysOnTop = true
                            bb.Parent = part

                            local lbl = Instance.new("TextLabel", bb)
                            lbl.Size = UDim2.new(1, 0, 1, 0)
                            lbl.BackgroundTransparency = 1
                            lbl.Font = Enum.Font.GothamBlack
                            lbl.Text = "[" .. data.RarityName .. "]\n" .. obj.Name
                            lbl.TextColor3 = data.Color
                            lbl.TextStrokeTransparency = 0.2
                            lbl.TextSize = 11
                        end
                    end
                end
            end)
        end
    end
end)

