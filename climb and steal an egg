-- Fungsi Pindah Cepat / Instant Snap (Tanpa Ragu-ragu)
local function moveCharacterTo(targetCF, forceInstantSnap)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        State.IsGliding = false
        return false
    end

    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(targetCF.Position, 2)
    end)

    -- Jika Instant Snap aktif (misal saat balik ke Base), langsung teleport dalam 1 frame tanpa tween!
    if forceInstantSnap or Config.InstantSnapToEgg then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = targetCF
        return true
    end

    State.IsGliding = true
    State.CancelGlide = false

    local dist = (root.Position - targetCF.Position).Magnitude
    local duration = math.clamp(dist / math.max(30, Config.GlideSpeed), 0.05, 1.4)

    local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = targetCF
    })
    tw:Play()

    local waited = 0
    while waited < duration do
        if State.CancelGlide or not root.Parent or hum.Health <= 0 then
            tw:Cancel()
            break
        end
        waited = waited + task.wait(0.02)
    end

    if root and root.Parent and not State.CancelGlide and hum.Health > 0 then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = targetCF
    end

    State.IsGliding = false
    return true
end

-- Pemicu Interaksi Telur (Prompt + Touch + Remote)
local function fireAllEggTriggers(eggObj, part, root)
    -- 1. Trigger Semua ProximityPrompt dengan Jarak Tak Terbatas
    local prompts = {}
    for _, d in ipairs(eggObj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
    end
    if eggObj.Parent then
        for _, d in ipairs(eggObj.Parent:GetChildren()) do
            if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
        end
    end

    for _, pr in ipairs(prompts) do
        pr.HoldDuration = 0
        pr.MaxActivationDistance = 99999
        pr.RequiresLineOfSight = false
        if fireproximityprompt then
            pcall(function() fireproximityprompt(pr) end)
        end
        pcall(function()
            pr:InputHoldBegin()
            pr:InputHoldEnd()
        end)
    end

    -- 2. Trigger TouchInterest
    if firetouchinterest and root and part then
        pcall(function()
            firetouchinterest(root, part, 0)
            firetouchinterest(root, part, 1)
        end)
    end

    -- 3. Trigger ClickDetector
    for _, cd in ipairs(eggObj:GetDescendants()) do
        if cd:IsA("ClickDetector") then
            cd.MaxActivationDistance = 99999
            if fireclickdetector then
                pcall(function() fireclickdetector(cd) end)
            end
        end
    end

    -- 4. Tembakkan RemoteEvent Pengambilan Egg
    for _, rem in ipairs(State.EggRemotes) do
        if rem:IsA("RemoteEvent") then
            pcall(function() rem:FireServer(eggObj) end)
            pcall(function() rem:FireServer(eggObj.Name) end)
        end
    end
end

-- FITUR BARU: Auto Collect Egg Saat Karakter Diam (Stationary Collect)
local function collectEggWhileStandingStill(eggItem)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return false end

    local eggObj = eggItem.Object
    local part = eggItem.Part
    if not eggObj or not part then return false end

    State.VisitedEggs[eggObj] = tick() + Config.EggCooldownSec
    local savedStandCFrame = root.CFrame
    local savedEggCFrame = part.CFrame
    local savedCamType = Camera.CameraType
    local savedCamCF = Camera.CFrame

    -- Langkah 1: Tarik hitbox telur ke posisi karakter secara tak terlihat + Fire Remote & Prompt
    pcall(function()
        part.CanCollide = false
        part.CFrame = savedStandCFrame
    end)
    fireAllEggTriggers(eggObj, part, root)

    -- Langkah 2: Jika Ghost Sync aktif (untuk server yang mengecek jarak karakter di sisi server),
    -- kunci kamera agar layar dan karakter terlihat tetap diam di tempat, lalu kirim paket posisi 1-frame
    if Config.StationaryGhostSync then
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = savedCamCF

        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = savedEggCFrame + Vector3.new(0, 1.8, 0)
        RunService.Heartbeat:Wait()
        fireAllEggTriggers(eggObj, part, root)

        -- Jika Auto Deposit aktif, langsung kirim sentuhan 1-frame ke Deposit Pad Base sebelum kembali ke titik diam
        if Config.StationaryAutoDeposit and Config.DepositPadCFrame then
            root.CFrame = Config.DepositPadCFrame
            RunService.Heartbeat:Wait()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Position - Config.DepositPadCFrame.Position).Magnitude < 16 then
                    if firetouchinterest then
                        pcall(function()
                            firetouchinterest(root, obj, 0)
                            firetouchinterest(root, obj, 1)
                        end)
                    end
                    local pr = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if pr and fireproximityprompt then
                        pr.HoldDuration = 0
                        pcall(function() fireproximityprompt(pr) end)
                    end
                end
            end
        end

        -- Kembalikan karakter ke posisi berdiri semula dalam frame yang sama
        root.CFrame = savedStandCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        Camera.CameraType = savedCamType
    end

    pcall(function()
        if part and part.Parent then
            part.CFrame = savedEggCFrame
        end
    end)

    State.CollectedCount = State.CollectedCount + 1
    return true
end

-- Fungsi Setor ke Base Langsung Tanpa Ragu-ragu (Instant Snap Deposit)
local function instantReturnAndDepositToBase()
    local targetDeposit = Config.DepositPadCFrame or Config.BaseCFrame
    if not targetDeposit then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    LiveStatus.Text = "Instant Teleport ke Base & Setor Egg..."

    -- Langsung pindah ke Base (Instant Snap jika diaktifkan)
    moveCharacterTo(targetDeposit + Vector3.new(0, 1.8, 0), Config.InstantSnapToBase)

    -- Sentuh & picu pad deposit secara instan
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Position - targetDeposit.Position).Magnitude < 18 then
            local n = string.lower(obj.Name)
            if n:find("deposit") or n:find("place") or n:find("deliver") or n:find("drop") or n:find("pad") or n:find("collect") or n:find("base") then
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(root, obj, 0)
                        firetouchinterest(root, obj, 1)
                    end)
                end
            end
            local pr = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pr then
                pr.HoldDuration = 0
                if fireproximityprompt then pcall(function() fireproximityprompt(pr) end) end
                pcall(function()
                    pr:InputHoldBegin()
                    pr:InputHoldEnd()
                end)
            end
        end
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.02)
