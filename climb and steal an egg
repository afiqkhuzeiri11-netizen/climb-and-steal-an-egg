addGlobalConn(RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not isValidInstance(char) then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then return end

	-- Jangan sentuh AssemblyLinearVelocity saat State.IsGliding == true agar tidak konflik dengan TweenService
	if Config.VelocityBypass and not State.IsGliding then
		if State.IsPressingEgg or Config.AutoFarmMove then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if isValidInstance(SafePad) then
		if Config.AirWalkFloat and State.AirWalkY and not State.IsGliding then
			SafePad.CanCollide = true
			SafePad.CFrame = CFrame.new(root.Position.X, State.AirWalkY, root.Position.Z)
		elseif State.IsPressingEgg and Config.FloatPadBypass and not State.IsGliding then
			SafePad.CanCollide = true
