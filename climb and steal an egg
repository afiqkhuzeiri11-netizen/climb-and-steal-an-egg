local function selectBestWildEgg(rootPos)
	refreshEggCache()
	local chosenArea = RarityAreas[Config.SelectedAreaIndex] or RarityAreas[1]
	local bestEgg = nil
	local highestMetric = -math.huge

	for _, item in ipairs(State.EggCache) do
		if isValidInstance(item.Object) and isValidInstance(item.Part) then
			local isMythicOverride = Config.AutoMythicSniper and (item.RarityId >= 5)
			local isAreaMatch = false

			if chosenArea.Id == 0 or isMythicOverride then
				isAreaMatch = true
			elseif Config.StrictAreaRarityMatch then
				isAreaMatch = (item.RarityId == chosenArea.Id)
			else
				isAreaMatch = (item.RarityId == chosenArea.Id) or (item.ZoneId == chosenArea.Id)
			end

			if isAreaMatch then
				local dist = (rootPos - item.Part.Position).Magnitude
				local metric = Config.PrioritizeHighestRarity and ((item.RarityId * 25000) - dist) or (-dist)
				if metric > highestMetric then
					highestMetric = metric
					bestEgg = item
				end
			end
		end
	end

	return bestEgg, chosenArea
end

-- Loop Utama Auto Steal + 6-Layer Hyper-Press
spawnManagedThread(function()
	while State.ScriptAlive and task.wait(0.25) do
		if Config.AutoFarmMove and not State.AdminDetected then
			pcall(function()
				local char = LocalPlayer.Character
				local root = isValidInstance(char) and char:FindFirstChild("HumanoidRootPart")
				local hum = isValidInstance(char) and char:FindFirstChildOfClass("Humanoid")
				if not isValidInstance(root) or not isValidInstance(hum) or hum.Health <= 0 then return end

				local bestEgg, chosenArea = selectBestWildEgg(root.Position)
				if bestEgg and isValidInstance(bestEgg.Object) and isValidInstance(bestEgg.Part) then
					State.CycleCount = State.CycleCount + 1
					if isValidInstance(LiveStatus) then
						LiveStatus.Text = string.format("Menuju [%s] %s...", bestEgg.Tag, bestEgg.Object.Name)
					end

					local approachPos = bestEgg.Part.Position + Vector3.new(0, 1.5, 2.2)
					local arrived = moveCharacterTo(CFrame.lookAt(approachPos, bestEgg.Part.Position), Config.InstantSnapToEgg)

					if arrived and Config.AutoFarmMove and isValidInstance(hum) and hum.Health > 0 then
						executeHyperPressGrab(bestEgg)
					end

					if Config.AutoFarmMove and isValidInstance(hum) and hum.Health > 0 then
						depositCarriedEggToBase()
					end
				else
					local standbyCF = Config.CustomStandbyCFrame or (chosenArea.Id > 0 and State.ZoneCheckpoints[chosenArea.Id])
					if Config.AutoStandbyInArea and standbyCF and isValidInstance(root) then
						if (root.Position - standbyCF.Position).Magnitude > 30 then
							if isValidInstance(LiveStatus) then
								LiveStatus.Text = "Naik ke " .. chosenArea.ShortName .. " (Memuat Area)..."
