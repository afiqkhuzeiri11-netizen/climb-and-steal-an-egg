-- Fungsi Meluncur Bertahap (Segmented Tween Bypass untuk jarak jauh/tinggi)
local function safeGlideTo(targetCFrame)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    IsFarmingAction = true
    local startPos = root.Position
    local targetPos = targetCFrame.Position
    local totalDist = (targetPos - startPos).Magnitude

    if Config.SegmentedBypass and totalDist > 120 then
        local steps = math.ceil(totalDist / 90)
        for i = 1, steps do
            if AdminPaused then break end
            local alpha = i / steps
            local nextPos = startPos:Lerp(targetPos, alpha)
            local stepDist = (root.Position - nextPos).Magnitude
            local stepTime = math.clamp(stepDist / Config.ClimbSpeed, 0.1, 1.8)

            ActiveTween = TweenService:Create(root, TweenInfo.new(stepTime, Enum.EasingStyle.Linear), {
                CFrame = CFrame.new(nextPos)
            })
            ActiveTween:Play()
            ActiveTween.Completed:Wait()
            task.wait(0.04) -- Jeda sinkronisasi server
        end
    else
        local duration = math.clamp(totalDist / Config.ClimbSpeed, 0.08, 3.0)
        ActiveTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            CFrame = targetCFrame
        })
        ActiveTween:Play()
        ActiveTween.Completed:Wait()
    end

    root.CFrame = targetCFrame
    IsFarmingAction = false
    return true
end

-- Fungsi Interaksi Mengambil & Klaim Telur ke Inventory
local function executeEggSteal(eggObj)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local part = getPart(eggObj)
    if not root or not part then return end

    -- 1. Pemicu ProximityPrompt (Instan tanpa tahan tombol)
    for _, desc in ipairs(eggObj:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            desc.HoldDuration = 0
            if fireproximityprompt then
                pcall(function() fireproximityprompt(desc) end)
            end
        end
    end
    if eggObj.Parent then
        local parentPrompt = eggObj.Parent:FindFirstChildWhichIsA("ProximityPrompt")
        if parentPrompt then
            parentPrompt.HoldDuration = 0
            if fireproximityprompt then
                pcall(function() fireproximityprompt(parentPrompt) end)
            end
        end
    end

    -- 2. Pemicu Sentuhan Fisik (TouchInterest)
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, part, 0)
            task.wait(0.03)
            firetouchinterest(root, part, 1)
        end)
    end

    -- 3. Pemicu ClickDetector
    local clicker = eggObj:FindFirstChildWhichIsA("ClickDetector", true)
    if clicker and fireclickdetector then
        pcall(function() fireclickdetector(clicker) end)
    end

    -- 4. Pemicu RemoteEvent Steal/Collect
    for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
        if rem:IsA("RemoteEvent") then
            local rn = string.lower(rem.Name)
            if rn:find("steal") or rn:find("collect") or rn:find("grab") or rn:find("pickup") or rn:find("claim") then
                pcall(function() rem:FireServer(eggObj) end)
            end
        end
    end
end

